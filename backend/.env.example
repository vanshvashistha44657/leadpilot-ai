# LeadPilot local backend defaults. Keep live sending disabled until all
# compliance and provider requirements are independently verified.
DATABASE_PATH=backend/data/leadpilot.db
BACKUP_DIRECTORY=backend/backups
LOCAL_TOKEN=replace-with-a-long-random-local-token
LOCAL_ONLY_API=true
DRY_RUN=true
LIVE_SENDING_ENABLED=false
EMAIL_PROVIDER=mock
IMPORT_BATCH_SIZE=100
LOG_LEVEL=INFO

# AI uses an OpenAI-compatible JSON HTTP endpoint. Keep AI_PROVIDER=none until
# an environment-only key and model are intentionally configured. The API never
# returns AI_API_KEY and does not call a provider while it is absent.
AI_PROVIDER=none
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_TIMEOUT_SECONDS=20
AI_MAX_RETRIES=2
AI_RETRY_BACKOFF_SECONDS=0.25

# Gmail provider status is reported as unconfigured until all values exist.
# Never commit real values.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_REDIRECT_URI=http://127.0.0.1:8000/api/gmail/oauth/callback
GMAIL_SENDER_EMAIL=
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.modify
GMAIL_TOKEN_PATH=
GMAIL_TIMEOUT_SECONDS=20
GMAIL_MAX_RETRIES=2
GMAIL_RETRY_BACKOFF_SECONDS=0.25
# This is deliberately false. Setting it is an explicit operator approval;
# live_sending_enabled and DRY_RUN remain independent safety gates.
GMAIL_LIVE_SEND_APPROVED=false
GMAIL_LIVE_SEND_TESTED=false # set only after a controlled provider integration test

# Microsoft Graph provider status is reported as unconfigured until all values exist.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER_EMAIL=
