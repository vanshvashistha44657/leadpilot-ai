# LeadPilot local backend defaults. Keep live sending disabled until all
# compliance and provider requirements are independently verified.
DATABASE_PATH=backend/data/leadpilot.db
BACKUP_DIRECTORY=backend/backups
LOCAL_TOKEN=replace-with-a-long-random-local-token
LOCAL_ONLY_API=true
DRY_RUN=true
LIVE_SENDING_ENABLED=false
EMAIL_PROVIDER=mock
IMPORT_BATCH_SIZE=100
LOG_LEVEL=INFO

# AI uses an OpenAI-compatible JSON HTTP endpoint. Keep AI_PROVIDER=none until
# an environment-only key and model are intentionally configured. The non-secret
# provider/model/URL/retry values can also be changed from the authenticated
# desktop Settings screen and are stored in SQLite. The API never returns
# AI_API_KEY and does not call a provider while it is absent.
AI_PROVIDER=none
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_TIMEOUT_SECONDS=20
AI_MAX_RETRIES=2
AI_RETRY_BACKOFF_SECONDS=0.25

# Phase 3 Gmail uses only the minimum scopes needed for local draft creation and
# permitted thread/message synchronization. gmail.modify is intentionally not
# requested. OAuth creates a one-time server state plus PKCE S256 challenge;
# the callback is the exact loopback URI below and is the only browser-reachable
# API route without X-Local-Token.
# Never commit real values.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://127.0.0.1:8000/api/gmail/oauth/callback
GMAIL_SENDER_EMAIL=
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.compose https://www.googleapis.com/auth/gmail.readonly
# Leave blank to use the per-user DPAPI path; any configured path is still
# encrypted and is rejected when it resolves inside the repository.
GMAIL_TOKEN_PATH=
GMAIL_TIMEOUT_SECONDS=20
GMAIL_MAX_RETRIES=2
GMAIL_RETRY_BACKOFF_SECONDS=0.25
# These remain false. Phase 3 is draft-only and never calls Gmail send
# endpoints; the flags are retained only for compatibility with older config.
GMAIL_LIVE_SEND_APPROVED=false
GMAIL_LIVE_SEND_TESTED=false

# Microsoft Graph provider status is reported as unconfigured until all values exist.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER_EMAIL=
